# Shopify store used for checkout (cart permalinks). Once drink-elixir.co points at
# this site, set Shopify's primary domain to e.g. shop.drink-elixir.co and use that here.
NEXT_PUBLIC_SHOP_DOMAIN=drink-elixir.co

# The can: create it in Shopify, then paste its variant ID and price to switch it on.
NEXT_PUBLIC_CAN_VARIANT_ID=
NEXT_PUBLIC_CAN_PRICE=
